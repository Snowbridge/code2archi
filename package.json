{
  "name": "code2archi",
  "version": "5.7.1",
  "description": "Code to Archimate Modeler CLI",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "code2archi": "./dist/index.js",
    "c2a": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run readme:check && node --import tsx --test test/**/*.test.ts",
    "readme:sync": "tsx scripts/sync-readme-status.ts",
    "readme:check": "tsx scripts/sync-readme-status.ts --check"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "fast-xml-parser": "^5.11.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.13.3",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
